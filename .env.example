# Public site origin, also set SITE_URL to the same value in the backend.
SITE_URL=http://localhost:3000
# Backend origin accessible by the frontend server (no /api suffix).
API_SERVER_URL=http://localhost:3001
PORT=3000
HOST=0.0.0.0

# Browser requests use the frontend proxy by default.
VITE_API_URL=/api
VITE_IMAGES_API_URL=

# Replace the placeholder phone and paste actual profile/chat URLs.
# The phone alone can be used for Telegram and WhatsApp; MAX needs a profile URL.
VITE_MESSENGER_PHONE=+7 (000) 000-00-00
VITE_MAX_URL=
VITE_TELEGRAM_URL=
VITE_WHATSAPP_URL=
